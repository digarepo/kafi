  // Application Information
  submission_date date
  approval_date date
  expiry_date date
  visa_number varchar(100)

  // Lookup Foreign Keys
  visa_application_status_id uuid [not null]

  // Administrative
  notes text

  // Business Rules
  //   - approval_date >= submission_date
  //   - at most one approved visa application per registration (backend)

  // Audit
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  created_by uuid [not null]
  updated_by uuid [not null]

  Note: '''
  Represents the visa processing lifecycle for a registration.

  Each visa application belongs to exactly one registration.
