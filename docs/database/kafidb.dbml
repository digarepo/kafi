  deleted_at timestamp
}
Table document_statuses {
  id uuid [pk]

  code varchar(30) [not null, unique]
  name varchar(100) [not null]
  description text

  display_order int [not null, default: 1]

  is_active boolean [not null, default: true]

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  // Soft delete
  is_deleted boolean [not null, default: false]
  deleted_at timestamp
}
Table verification_statuses {
  id uuid [pk]

  code varchar(30) [not null, unique]
  name varchar(100) [not null]
  description text

  display_order int [not null, default: 1]

  is_active boolean [not null, default: true]

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  // Soft delete
  is_deleted boolean [not null, default: false]
  deleted_at timestamp
}
Table user_statuses {
  id uuid [pk]

  status_code varchar(30) [not null, unique]
  name varchar(100) [not null]

  is_active boolean [not null, default: true]

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: '''
  Defines lifecycle state of system users.

  Examples:
  - ACTIVE
  - INACTIVE
  - SUSPENDED
  - LOCKED
  - DELETED
  '''

  // Soft delete
  is_deleted boolean [not null, default: false]
  deleted_at timestamp
}
Table roles {
  id uuid [pk]

  role_code varchar(30) [not null, unique]
  name varchar(100) [not null]

  description text

  is_system_role boolean [not null, default: false]
  is_active boolean [not null, default: true]

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  // Soft delete
  is_deleted boolean [not null, default: false]
  deleted_at timestamp
}
Table user_roles {
  id uuid [pk]

  user_id uuid [not null]
  role_id uuid [not null]

  assigned_at timestamp [not null, default: `now()`]

  is_active boolean [not null, default: true]

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  created_by uuid [not null]
  updated_by uuid [not null]
  unique (user_id, role_id) {
    note: 'One role assignment per user-role pair'
  }

  // Soft delete
  is_deleted boolean [not null, default: false]
  deleted_at timestamp
}
Table permissions {
  id uuid [pk]

  permission_code varchar(50) [not null, unique]
  name varchar(100) [not null]

  description text

  module varchar(100)

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  // Soft delete
  is_deleted boolean [not null, default: false]
  deleted_at timestamp
}
Table role_permissions {
  id uuid [pk]

  role_id uuid [not null]
  permission_id uuid [not null]

  created_at timestamp [not null, default: `now()`]
  unique (role_id, permission_id) {
    note: 'One permission per role-permission pair'
  }

  // Soft delete
  is_deleted boolean [not null, default: false]
  deleted_at timestamp
}

