  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  created_by uuid
  updated_by uuid

  Note: '''
  Represents an authenticated staff member.

  Users may manage their own profile,
  including email address, phone number,
  password and other personal account
  settings.

  Administrative functions such as role
  assignment, account activation,
  suspension and permission management
  are performed by authorized users.
  '''

  // Soft delete
  is_deleted boolean [not null, default: false]
  deleted_at timestamp
}

