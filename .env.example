# MariaDB connection used by API, drizzle-kit, and seed scripts
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=

# Root admin credentials (used by database/seeds/seed.ts)
ROOT_ADMIN_EMAIL=
ROOT_ADMIN_PASSWORD=
ROOT_ADMIN_PHONE=251911000000

# JWT signing secrets (must each be at least 32 characters)
JWT_SECRET=change-me-to-a-secure-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-to-a-secure-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=
JWT_REFRESH_EXPIRY=


MAILER_DRIVER=
RESEND_API_KEY=
MAIL_FROM=
APP_URL=
ALLOWED_ORIGINS=
VITE_API_URL=

# Staff recipients notified when a public inquiry is received.
# Comma-separated. When empty, inquiries are still stored but no
# notification is sent (a warning is logged instead).
INQUIRY_NOTIFY_EMAILS=

# Internal workflow tick secret (for EasyCron / external schedulers)
# Must be at least 16 characters. Pass via x-workflow-tick-secret header.
WORKFLOW_TICK_SECRET=change-me-workflow-tick-secret

# Document file storage (local filesystem)
# - Absolute path: used as-is (recommended for production)
# - Relative path: resolved from the monorepo root in dev (two levels up
#   from apps/api) or one level up from the app directory in standalone
#   deployment (e.g. /home/user/api.kafitour.com → /home/user/storage/documents)
# Production: set to an absolute path like /home/user/storage/documents
DOCUMENT_STORAGE_PATH=storage/documents

# Google Analytics 4 measurement ID for the public website.
# Leave empty in development to skip loading the script.
# Production: set to your GA4 measurement ID (e.g. G-XXXXXXXXXX).
VITE_GA4_MEASUREMENT_ID=

# Base URL for dynamic OG images generated by the API.
# Used by the web app to construct og:image URLs for package pages.
# Defaults to the API URL if not set.
VITE_OG_IMAGE_BASE=

# Path to the TTF font file used by the OG image generator.
# Defaults to the bundled assets/inter-700.ttf in the API build output.
# Override only if deploying with a custom font location.
OG_IMAGE_FONT_PATH=
